# Angel One SmartAPI (free). Copy this file to .env.local in the same folder and fill it in.
# .env.local is ignored by git, stays on your PC, and is only read by the local dev server (npm run dev).
# NSE Visor only reads market data with these details: it never places orders.

# From your app at smartapi.angelbroking.com
ANGEL_API_KEY=
# Your Angel One client ID
ANGEL_CLIENT_CODE=
# Your Angel One login PIN
ANGEL_PIN=
# The TOTP secret shown under the QR code at smartapi.angelbroking.com/enable-totp (not the API secret)
ANGEL_TOTP_SECRET=

# Optional: only if Angel One gave historical data its own API key
ANGEL_HISTORICAL_API_KEY=
# Optional: up to 10 stocks whose market depth is saved every second during market hours, to data-local/depth/
ANGEL_RECORD=
